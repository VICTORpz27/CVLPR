{
  "name": "cvl-pierre-rouges",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "cvl-idees", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }],
  "ai": { "binding": "AI" }
}
